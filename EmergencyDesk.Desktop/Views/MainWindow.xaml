<Window x:Class="EmergencyDesk.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:m="clr-namespace:EmergencyDesk.Models"
        Title="Emergency Desk" Width="1280" Height="780" MinWidth="1000" MinHeight="620"
        WindowStartupLocation="CenterScreen" Background="{StaticResource BgBrush}">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <Style x:Key="PageStyle" TargetType="Grid">
            <Setter Property="Visibility" Value="Collapsed"/>
        </Style>

        <Style x:Key="StatTitle" TargetType="TextBlock" BasedOn="{StaticResource Muted}">
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <Style x:Key="StatValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="34"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        </Style>
        <Style x:Key="Label" TargetType="TextBlock" BasedOn="{StaticResource Muted}">
            <Setter Property="Margin" Value="0,10,0,4"/>
        </Style>

        <!-- one row of a "by type / by time / by location" bar list -->
        <DataTemplate x:Key="BarRowTemplate">
            <Grid Margin="0,3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="90"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Label}"
                           VerticalAlignment="Center" FontSize="12"/>
                <ProgressBar Grid.Column="1" Minimum="0" Maximum="100" Value="{Binding Percent, Mode=OneWay}"
                             Height="10" Margin="8,0" BorderThickness="0" Background="#26323F"
                             Foreground="{StaticResource AccentBrush}"/>
                <TextBlock Grid.Column="2" Text="{Binding CountText}" HorizontalAlignment="Right"
                           Style="{StaticResource Muted}" FontSize="12" VerticalAlignment="Center"/>
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Grid.Column="0" Background="{StaticResource PanelBrush}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="18,22,18,22">
                    <TextBlock Text="EMERGENCY DESK" FontWeight="Bold" FontSize="14"
                               Foreground="{StaticResource AccentBrush}"/>
                    <TextBlock Text="{Binding DisplayName}" FontSize="15" Margin="0,10,0,0"/>
                    <TextBlock Text="{Binding Role}" Style="{StaticResource Muted}" FontSize="12"/>
                </StackPanel>

                <StackPanel DockPanel.Dock="Bottom" Margin="16">
                    <Button Content="Sign out" Command="{Binding LogoutCommand}"/>
                </StackPanel>

                <StackPanel>
                    <RadioButton Style="{StaticResource NavButton}" GroupName="nav" Content="Dashboard"
                                 IsChecked="{Binding CurrentPage, Mode=TwoWay, Converter={StaticResource EqualsParam}, ConverterParameter=Dashboard}"/>
                    <RadioButton Style="{StaticResource NavButton}" GroupName="nav"
                                 IsChecked="{Binding CurrentPage, Mode=TwoWay, Converter={StaticResource EqualsParam}, ConverterParameter=Incidents}">
                        <TextBlock>
                            <Run Text="Incident queue"/>
                            <Run Text="{Binding NewCount, Mode=OneWay, StringFormat='  ({0} new)'}" Foreground="{StaticResource AccentBrush}"/>
                        </TextBlock>
                    </RadioButton>
                    <RadioButton Style="{StaticResource NavButton}" GroupName="nav" Content="Responders"
                                 IsChecked="{Binding CurrentPage, Mode=TwoWay, Converter={StaticResource EqualsParam}, ConverterParameter=Responders}"/>
                    <RadioButton Style="{StaticResource NavButton}" GroupName="nav" Content="Analytics"
                                 IsChecked="{Binding CurrentPage, Mode=TwoWay, Converter={StaticResource EqualsParam}, ConverterParameter=Analytics}"/>
                    <RadioButton Style="{StaticResource NavButton}" GroupName="nav" Content="Operator performance"
                                 Visibility="{Binding IsAdmin, Converter={StaticResource BoolToVis}}"
                                 IsChecked="{Binding CurrentPage, Mode=TwoWay, Converter={StaticResource EqualsParam}, ConverterParameter=Operators}"/>
                    <RadioButton Style="{StaticResource NavButton}" GroupName="nav" Content="Rules &amp; SLA"
                                 IsChecked="{Binding CurrentPage, Mode=TwoWay, Converter={StaticResource EqualsParam}, ConverterParameter=Rules}"/>
                    <RadioButton Style="{StaticResource NavButton}" GroupName="nav" Content="Scheduled reports"
                                 Visibility="{Binding IsAdmin, Converter={StaticResource BoolToVis}}"
                                 IsChecked="{Binding CurrentPage, Mode=TwoWay, Converter={StaticResource EqualsParam}, ConverterParameter=Schedule}"/>
                    <RadioButton Style="{StaticResource NavButton}" GroupName="nav" Content="Audit log"
                                 Visibility="{Binding IsAdmin, Converter={StaticResource BoolToVis}}"
                                 IsChecked="{Binding CurrentPage, Mode=TwoWay, Converter={StaticResource EqualsParam}, ConverterParameter=Audit}"/>
                    <RadioButton Style="{StaticResource NavButton}" GroupName="nav" Content="App Users"
                                 Visibility="{Binding IsAdmin, Converter={StaticResource BoolToVis}}"
                                 IsChecked="{Binding CurrentPage, Mode=TwoWay, Converter={StaticResource EqualsParam}, ConverterParameter=Users}"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Content -->
        <Grid Grid.Column="1" Margin="24,20,12,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Escalation banner (visible on every page) -->
            <Border Grid.Row="0" Margin="0,0,12,12" Padding="14,10" CornerRadius="8"
                    Background="#3A1518" BorderBrush="{StaticResource AccentBrush}" BorderThickness="1">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasEscalations}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="Review" Style="{StaticResource PrimaryButton}"
                            Command="{Binding ShowEscalatedCommand}" Margin="12,0,0,0"/>
                    <TextBlock Text="{Binding EscalationBannerText}" FontWeight="SemiBold"
                               VerticalAlignment="Center" TextWrapping="Wrap"/>
                </DockPanel>
            </Border>

            <Grid Grid.Row="1">

                <!-- DASHBOARD -->
                <Grid>
                    <Grid.Style>
                        <Style TargetType="Grid" BasedOn="{StaticResource PageStyle}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CurrentPage}" Value="Dashboard">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="Dashboard" Style="{StaticResource Heading}" Margin="0,0,0,16"/>

                    <UniformGrid Grid.Row="1" Rows="1" Columns="4">
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="NEW REPORTS" Style="{StaticResource StatTitle}"/>
                                <TextBlock Text="{Binding PendingCount}" Style="{StaticResource StatValue}"
                                           Foreground="{StaticResource AccentBrush}"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="ACTIVE" Style="{StaticResource StatTitle}"/>
                                <TextBlock Text="{Binding ActiveCount}" Style="{StaticResource StatValue}"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="RESOLVED" Style="{StaticResource StatTitle}"/>
                                <TextBlock Text="{Binding ResolvedCount}" Style="{StaticResource StatValue}"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="RESPONDERS AVAILABLE" Style="{StaticResource StatTitle}"/>
                                <TextBlock Text="{Binding AvailableResponders}" Style="{StaticResource StatValue}"/>
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <!-- KPIs -->
                    <UniformGrid Grid.Row="2" Rows="1" Columns="4">
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="ALERTS TODAY" Style="{StaticResource StatTitle}"/>
                                <TextBlock Text="{Binding KpiAlertsToday}" Style="{StaticResource StatValue}"/>
                                <TextBlock Text="excluding merged duplicates" Style="{StaticResource Muted}" FontSize="11"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}"
                                ToolTip="Time from the report arriving until an operator acknowledged it. Last 7 days.">
                            <StackPanel>
                                <TextBlock Text="AVG RESPONSE TIME (7 DAYS)" Style="{StaticResource StatTitle}"/>
                                <TextBlock Text="{Binding KpiAvgResponse}" Style="{StaticResource StatValue}"/>
                                <TextBlock Text="{Binding KpiAvgDispatchText}" Style="{StaticResource Muted}" FontSize="11"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}"
                                ToolTip="Incidents closed as Cancelled divided by all incidents reported. Last 7 days.">
                            <StackPanel>
                                <TextBlock Text="FALSE-ALARM RATE (7 DAYS)" Style="{StaticResource StatTitle}"/>
                                <TextBlock Text="{Binding KpiFalseAlarmRate}" Style="{StaticResource StatValue}"/>
                                <TextBlock Text="{Binding KpiFalseAlarmDetail}" Style="{StaticResource Muted}" FontSize="11"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="OPEN INCIDENTS" Style="{StaticResource StatTitle}"/>
                                <TextBlock Text="{Binding KpiOpen}" Style="{StaticResource StatValue}"/>
                                <TextBlock Text="not resolved or cancelled" Style="{StaticResource Muted}" FontSize="11"/>
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <Border Grid.Row="3" Style="{StaticResource Card}" Padding="0">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Text="Latest reports" FontSize="15" FontWeight="SemiBold"
                                       Margin="18,16,18,10"/>
                            <DataGrid ItemsSource="{Binding IncidentsView}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="#" Binding="{Binding Id}" Width="50"/>
                                    <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="90"/>
                                    <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="100"/>
                                    <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="*"/>
                                    <DataGridTextColumn Header="Reported" Binding="{Binding ReportedLocal}" Width="150"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </Border>
                </Grid>

                <!-- INCIDENT QUEUE / INBOX -->
                <Grid>
                    <Grid.Style>
                        <Style TargetType="Grid" BasedOn="{StaticResource PageStyle}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CurrentPage}" Value="Incidents">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="320"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.ColumnSpan="2" Text="Incident queue" Style="{StaticResource Heading}" Margin="0,0,0,12"/>

                    <!-- lifecycle filter chips -->
                    <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,0,12,12">
                        <RadioButton Style="{StaticResource ChipButton}" GroupName="queue"
                                     IsChecked="{Binding QueueFilter, Mode=TwoWay, Converter={StaticResource EqualsParam}, ConverterParameter=Open}">
                            <TextBlock><Run Text="Open  "/><Run Text="{Binding OpenCount, Mode=OneWay}" FontWeight="Bold"/></TextBlock>
                        </RadioButton>
                        <RadioButton Style="{StaticResource ChipButton}" GroupName="queue"
                                     IsChecked="{Binding QueueFilter, Mode=TwoWay, Converter={StaticResource EqualsParam}, ConverterParameter=New}">
                            <TextBlock><Run Text="New  "/><Run Text="{Binding NewCount, Mode=OneWay}" FontWeight="Bold"/></TextBlock>
                        </RadioButton>
                        <RadioButton Style="{StaticResource ChipButton}" GroupName="queue"
                                     IsChecked="{Binding QueueFilter, Mode=TwoWay, Converter={StaticResource EqualsParam}, ConverterParameter=Acknowledged}">
                            <TextBlock><Run Text="Acknowledged  "/><Run Text="{Binding AckedCount, Mode=OneWay}" FontWeight="Bold"/></TextBlock>
                        </RadioButton>
                        <RadioButton Style="{StaticResource ChipButton}" GroupName="queue"
                                     IsChecked="{Binding QueueFilter, Mode=TwoWay, Converter={StaticResource EqualsParam}, ConverterParameter=InProgress}">
                            <TextBlock><Run Text="In progress  "/><Run Text="{Binding InProgressCount, Mode=OneWay}" FontWeight="Bold"/></TextBlock>
                        </RadioButton>
                        <RadioButton Style="{StaticResource ChipButton}" GroupName="queue"
                                     IsChecked="{Binding QueueFilter, Mode=TwoWay, Converter={StaticResource EqualsParam}, ConverterParameter=Escalated}">
                            <TextBlock><Run Text="Escalated  "/><Run Text="{Binding EscalatedCount, Mode=OneWay}" FontWeight="Bold"/></TextBlock>
                        </RadioButton>
                        <RadioButton Style="{StaticResource ChipButton}" GroupName="queue"
                                     IsChecked="{Binding QueueFilter, Mode=TwoWay, Converter={StaticResource EqualsParam}, ConverterParameter=Closed}">
                            <TextBlock><Run Text="Closed  "/><Run Text="{Binding ClosedCount, Mode=OneWay}" FontWeight="Bold"/></TextBlock>
                        </RadioButton>
                    </StackPanel>

                    <Border Grid.Row="2" Style="{StaticResource Card}" Padding="0">
                        <DataGrid ItemsSource="{Binding QueueView}" SelectedItem="{Binding SelectedIncident}"
                                  CanUserSortColumns="False">
                            <DataGrid.RowStyle>
                                <Style TargetType="DataGridRow">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsEscalated}" Value="True">
                                            <Setter Property="Background" Value="#3A1518"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGrid.RowStyle>
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="Priority" Width="100">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border CornerRadius="4" Padding="7,1" HorizontalAlignment="Left"
                                                    Background="{Binding PriorityLevel, Converter={StaticResource PriorityBrush}}"
                                                    ToolTip="{Binding PriorityReason}">
                                                <TextBlock Text="{Binding PriorityLabel}" FontSize="12" FontWeight="SemiBold" Foreground="White"/>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="#" Binding="{Binding Id}" Width="45"/>
                                <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="75"/>
                                <DataGridTextColumn Header="People" Binding="{Binding PeopleText}" Width="82"/>
                                <DataGridTemplateColumn Header="State" Width="105">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding StateText}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsEscalated}" Value="True">
                                                                <Setter Property="Foreground" Value="#FF6B6F"/>
                                                                <Setter Property="FontWeight" Value="Bold"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Ack SLA" Width="105">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding SlaAckText}"
                                                       Foreground="{Binding SlaAckState, Converter={StaticResource SlaBrush}}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Dispatch SLA" Width="115">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding SlaDispatchText}"
                                                       Foreground="{Binding SlaDispatchState, Converter={StaticResource SlaBrush}}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Flags" Binding="{Binding FlagsText, Mode=OneWay}" Width="95"/>
                                <DataGridTextColumn Header="Responder" Binding="{Binding AssignedResponderName}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>

                    <Border Grid.Row="2" Grid.Column="1" Style="{StaticResource Card}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel DataContext="{Binding}">
                                <TextBlock Text="Incident details" FontSize="15" FontWeight="SemiBold"/>
                                <TextBlock Text="Select an incident from the list." Margin="0,8,0,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource Muted}">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SelectedIncident}" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>

                                <StackPanel DataContext="{Binding SelectedIncident}">
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="Visibility" Value="Visible"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding}" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>

                                    <!-- Acknowledge (only while the incident is still New) -->
                                    <Button Content="Acknowledge this incident"
                                            Command="{Binding DataContext.AcknowledgeSelectedCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            HorizontalAlignment="Stretch" Margin="0,12,0,0" Padding="14,10">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding QueueState}" Value="New">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                    <TextBlock Text="{Binding AckText}" TextWrapping="Wrap" Margin="0,8,0,0">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource Muted}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding AckText}" Value="">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>

                                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                        <Button Content="Export PDF" ToolTip="Incident report with full timeline"
                                                Command="{Binding DataContext.ExportIncidentPdfCommand, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                        <Button Content="Export CSV" ToolTip="Incident report with full timeline (opens in Excel)"
                                                Command="{Binding DataContext.ExportIncidentCsvCommand, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                    </StackPanel>

                                    <TextBlock Text="Priority" Style="{StaticResource Label}"/>
                                    <StackPanel Orientation="Horizontal">
                                        <Border CornerRadius="4" Padding="8,2" HorizontalAlignment="Left"
                                                Background="{Binding PriorityLevel, Converter={StaticResource PriorityBrush}}">
                                            <TextBlock Text="{Binding PriorityLabel}" FontWeight="Bold" Foreground="White"/>
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="{Binding PriorityReason}" Style="{StaticResource Muted}"
                                               TextWrapping="Wrap" Margin="0,4,0,0" FontSize="12"/>

                                    <TextBlock Text="SLA timers" Style="{StaticResource Label}"/>
                                    <TextBlock>
                                        <Run Text="Acknowledge:  "/>
                                        <Run Text="{Binding SlaAckText, Mode=OneWay}" FontWeight="SemiBold"
                                             Foreground="{Binding SlaAckState, Converter={StaticResource SlaBrush}}"/>
                                    </TextBlock>
                                    <TextBlock>
                                        <Run Text="Dispatch:  "/>
                                        <Run Text="{Binding SlaDispatchText, Mode=OneWay}" FontWeight="SemiBold"
                                             Foreground="{Binding SlaDispatchState, Converter={StaticResource SlaBrush}}"/>
                                    </TextBlock>

                                    <!-- duplicate / merged notice -->
                                    <Border Margin="0,14,0,0" Padding="10" CornerRadius="6" Background="#3A2F12">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasDuplicateInfo}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <StackPanel>
                                            <TextBlock Text="{Binding DuplicateText}" TextWrapping="Wrap" Foreground="#F5C96A"/>
                                            <Button Content="Merge duplicates" Margin="0,8,0,0" HorizontalAlignment="Left"
                                                    Command="{Binding DataContext.MergeDuplicatesCommand, RelativeSource={RelativeSource AncestorType=Window}}">
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding CanMerge}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                        </StackPanel>
                                    </Border>

                                    <TextBlock Text="Description" Style="{StaticResource Label}"/>
                                    <TextBlock Text="{Binding Description}" TextWrapping="Wrap"/>
                                    <TextBlock Text="People involved" Style="{StaticResource Label}"/>
                                    <TextBlock Text="{Binding PeopleText}"/>
                                    <TextBlock Text="Reporter" Style="{StaticResource Label}"/>
                                    <TextBlock>
                                        <Run Text="{Binding ReporterName, Mode=OneWay}"/>
                                        <Run Text=" · "/>
                                        <Run Text="{Binding ReporterPhone, Mode=OneWay}"/>
                                    </TextBlock>
                                    <TextBlock Text="Location" Style="{StaticResource Label}"/>
                                    <TextBlock Text="{Binding Address}" TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding Coordinates}" Style="{StaticResource Muted}"/>
                                    <TextBlock Text="Reported" Style="{StaticResource Label}"/>
                                    <TextBlock Text="{Binding ReportedLocal}"/>

                                    <TextBlock Text="Timeline" Style="{StaticResource Label}"/>
                                    <ItemsControl ItemsSource="{Binding DataContext.SelectedTimeline, RelativeSource={RelativeSource AncestorType=Window}}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,2">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" MinWidth="64"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding TimeText}" Style="{StaticResource Muted}" FontSize="12" Margin="0,0,8,0"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding Text}" TextWrapping="Wrap" FontSize="12"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>

                                <TextBlock Text="Assign responder" Style="{StaticResource Label}" Margin="0,18,0,4"/>
                                <ComboBox ItemsSource="{Binding Responders}" SelectedItem="{Binding AssignChoice}"
                                          DisplayMemberPath="Name"/>
                                <Button Content="Assign" Command="{Binding AssignCommand}" Margin="0,8,0,0"
                                        Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left"/>

                                <TextBlock Text="Update status" Style="{StaticResource Label}" Margin="0,18,0,4"/>
                                <ComboBox ItemsSource="{Binding IncidentStatuses}" SelectedItem="{Binding NewStatusChoice}"/>
                                <Button Content="Update" Command="{Binding UpdateStatusCommand}" Margin="0,8,0,0"
                                        HorizontalAlignment="Left"/>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>

                <!-- RESPONDERS -->
                <Grid>
                    <Grid.Style>
                        <Style TargetType="Grid" BasedOn="{StaticResource PageStyle}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CurrentPage}" Value="Responders">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="320"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.ColumnSpan="2" Text="Responders" Style="{StaticResource Heading}" Margin="0,0,0,14"/>

                    <Border Grid.Row="1" Style="{StaticResource Card}" Padding="0">
                        <DataGrid ItemsSource="{Binding Responders}" SelectedItem="{Binding SelectedResponder}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*"/>
                                <DataGridTextColumn Header="Unit" Binding="{Binding Unit}" Width="130"/>
                                <DataGridTextColumn Header="Specialty" Binding="{Binding Specialty}" Width="100"/>
                                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="100"/>
                                <DataGridTextColumn Header="Region" Binding="{Binding Region}" Width="130"/>
                                <DataGridTextColumn Header="Active jobs" Binding="{Binding ActiveJobs}" Width="90"/>
                                <DataGridTextColumn Header="Phone" Binding="{Binding Phone}" Width="130"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>

                    <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource Card}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock Text="Responder" FontSize="15" FontWeight="SemiBold"/>
                                <TextBlock Text="Name" Style="{StaticResource Label}"/>
                                <TextBox Text="{Binding EditName, UpdateSourceTrigger=PropertyChanged}"/>
                                <TextBlock Text="Unit" Style="{StaticResource Label}"/>
                                <TextBox Text="{Binding EditUnit, UpdateSourceTrigger=PropertyChanged}"/>
                                <TextBlock Text="Phone" Style="{StaticResource Label}"/>
                                <TextBox Text="{Binding EditPhone, UpdateSourceTrigger=PropertyChanged}"/>
                                <TextBlock Text="Coverage region(s)" Style="{StaticResource Label}"/>
                                <TextBox Text="{Binding EditRegion, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="Comma-separated place names matched against the incident address, e.g. Makati, Taguig"/>
                                <TextBlock Text="Specialty" Style="{StaticResource Label}"/>
                                <ComboBox ItemsSource="{Binding IncidentTypes}" SelectedItem="{Binding EditSpecialty}"/>
                                <TextBlock Text="Status" Style="{StaticResource Label}"/>
                                <ComboBox ItemsSource="{Binding ResponderStatuses}" SelectedItem="{Binding EditStatus}"/>
                                <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                                    <Button Content="Save" Command="{Binding SaveResponderCommand}"
                                            Style="{StaticResource PrimaryButton}"/>
                                    <Button Content="New" Command="{Binding NewResponderCommand}"/>
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>

                <!-- RULES & SLA -->
                <Grid>
                    <Grid.Style>
                        <Style TargetType="Grid" BasedOn="{StaticResource PageStyle}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CurrentPage}" Value="Rules">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="Rules &amp; SLA" Style="{StaticResource Heading}" Margin="0,0,0,14"/>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel MaxWidth="620" HorizontalAlignment="Left" Margin="0,0,12,12">
                            <TextBlock Text="Only an admin can change these rules. They are stored on this desk." Margin="0,0,0,10">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource Muted}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsAdmin}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <StackPanel IsEnabled="{Binding IsAdmin}">
                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <TextBlock Text="Alerts" FontSize="15" FontWeight="SemiBold"/>
                                        <CheckBox Content="Play alarm sound while an alert is open" IsChecked="{Binding EditRules.SoundEnabled}"/>
                                        <DockPanel Margin="0,6">
                                            <TextBox DockPanel.Dock="Right" Width="80" Text="{Binding EditRules.ReAlertSeconds}"/>
                                            <TextBlock Text="Re-alert every (seconds) until acknowledged" VerticalAlignment="Center"/>
                                        </DockPanel>
                                        <DockPanel Margin="0,6">
                                            <TextBox DockPanel.Dock="Right" Width="80" Text="{Binding EditRules.StaleAfterHours}"/>
                                            <TextBlock Text="Stop alerting on unhandled reports older than (hours)" VerticalAlignment="Center"/>
                                        </DockPanel>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <TextBlock Text="Escalation &amp; SLA targets" FontSize="15" FontWeight="SemiBold"/>
                                        <DockPanel Margin="0,10,0,6">
                                            <TextBox DockPanel.Dock="Right" Width="80" Text="{Binding EditRules.EscalateAfterSeconds}"/>
                                            <TextBlock Text="Escalate to supervisor if unacknowledged after (seconds)" VerticalAlignment="Center"/>
                                        </DockPanel>
                                        <DockPanel Margin="0,6">
                                            <TextBox DockPanel.Dock="Right" Width="80" Text="{Binding EditRules.AckSlaSeconds}"/>
                                            <TextBlock Text="Time-to-acknowledge target (seconds)" VerticalAlignment="Center"/>
                                        </DockPanel>
                                        <DockPanel Margin="0,6">
                                            <TextBox DockPanel.Dock="Right" Width="80" Text="{Binding EditRules.DispatchSlaSeconds}"/>
                                            <TextBlock Text="Time-to-dispatch target (seconds)" VerticalAlignment="Center"/>
                                        </DockPanel>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <TextBlock Text="Auto-assignment" FontSize="15" FontWeight="SemiBold"/>
                                        <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4,0,6"
                                                   Text="Assigns an available responder to new reports automatically. Enable on one desk only, so two desks don't assign at once."/>
                                        <CheckBox Content="Enable auto-assignment on this desk" IsChecked="{Binding EditRules.AutoAssignEnabled}"/>
                                        <CheckBox Content="Prefer a responder whose specialty matches the incident type" IsChecked="{Binding EditRules.MatchSpecialty}"/>
                                        <CheckBox Content="Only assign a responder with a matching specialty" IsChecked="{Binding EditRules.RequireSpecialtyMatch}"/>
                                        <CheckBox Content="Prefer a responder whose coverage region appears in the address" IsChecked="{Binding EditRules.MatchRegion}"/>
                                        <CheckBox Content="Prefer the responder with the fewest active jobs" IsChecked="{Binding EditRules.BalanceWorkload}"/>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <TextBlock Text="Duplicate detection" FontSize="15" FontWeight="SemiBold"/>
                                        <DockPanel Margin="0,10,0,6">
                                            <TextBox DockPanel.Dock="Right" Width="80" Text="{Binding EditRules.DuplicateWindowMinutes}"/>
                                            <TextBlock Text="Time window (minutes)" VerticalAlignment="Center"/>
                                        </DockPanel>
                                        <DockPanel Margin="0,6">
                                            <TextBox DockPanel.Dock="Right" Width="80" Text="{Binding EditRules.DuplicateRadiusMeters}"/>
                                            <TextBlock Text="Same-type reports within (metres)" VerticalAlignment="Center"/>
                                        </DockPanel>
                                    </StackPanel>
                                </Border>

                                <Button Content="Save rules" Command="{Binding SaveRulesCommand}"
                                        Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Margin="0,0,0,8"/>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

<!-- ANALYTICS -->
                <Grid>
                    <Grid.Style>
                        <Style TargetType="Grid" BasedOn="{StaticResource PageStyle}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CurrentPage}" Value="Analytics">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <DockPanel Margin="0,0,12,10">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Content="Export summary PDF" Command="{Binding ExportSummaryPdfCommand}"/>
                            <Button Content="Export summary CSV" Command="{Binding ExportSummaryCsvCommand}" Margin="0"/>
                        </StackPanel>
                        <TextBlock Text="Analytics" Style="{StaticResource Heading}"/>
                    </DockPanel>

                    <StackPanel Grid.Row="1" Margin="0,0,12,10">
                        <StackPanel Orientation="Horizontal">
                        <RadioButton Style="{StaticResource ChipButton}" GroupName="rangeA"
                                     IsChecked="{Binding AnalyticsRange, Mode=TwoWay, Converter={StaticResource EqualsParam}, ConverterParameter=Today}">
                                         <TextBlock Text="Today"/>
                                 </RadioButton>
                        <RadioButton Style="{StaticResource ChipButton}" GroupName="rangeA"
                                     IsChecked="{Binding AnalyticsRange, Mode=TwoWay, Converter={StaticResource EqualsParam}, ConverterParameter=7}">
                                         <TextBlock Text="7 days"/>
                                 </RadioButton>
                        <RadioButton Style="{StaticResource ChipButton}" GroupName="rangeA"
                                     IsChecked="{Binding AnalyticsRange, Mode=TwoWay, Converter={StaticResource EqualsParam}, ConverterParameter=30}">
                                         <TextBlock Text="30 days"/>
                                 </RadioButton>
                        <RadioButton Style="{StaticResource ChipButton}" GroupName="rangeA"
                                     IsChecked="{Binding AnalyticsRange, Mode=TwoWay, Converter={StaticResource EqualsParam}, ConverterParameter=90}">
                                         <TextBlock Text="90 days"/>
                                 </RadioButton>
                        <RadioButton Style="{StaticResource ChipButton}" GroupName="rangeA"
                                     IsChecked="{Binding AnalyticsRange, Mode=TwoWay, Converter={StaticResource EqualsParam}, ConverterParameter=All}">
                                         <TextBlock Text="All time"/>
                                 </RadioButton>
                        </StackPanel>
                        <TextBlock Text="{Binding RangeSummaryText}" Style="{StaticResource Muted}" Margin="0,8,0,0" FontSize="12"/>
                    </StackPanel>

                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="0,0,0,12">
                            <UniformGrid Rows="1" Columns="4">
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="INCIDENTS" Style="{StaticResource StatTitle}"/>
                                    <TextBlock Text="{Binding RangeCount}" Style="{StaticResource StatValue}"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="AVG RESPONSE TIME" Style="{StaticResource StatTitle}"/>
                                    <TextBlock Text="{Binding RangeAvgAck}" Style="{StaticResource StatValue}"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="AVG TIME TO DISPATCH" Style="{StaticResource StatTitle}"/>
                                    <TextBlock Text="{Binding RangeAvgDispatch}" Style="{StaticResource StatValue}"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="FALSE-ALARM RATE" Style="{StaticResource StatTitle}"/>
                                    <TextBlock Text="{Binding RangeFalseAlarm}" Style="{StaticResource StatValue}"/>
                                </StackPanel>
                            </Border>
                            </UniformGrid>

                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="Incidents per day" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                                        <ItemsControl ItemsSource="{Binding DailyBars}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel Width="{Binding BarWidth}" Margin="1,0" ToolTip="{Binding Tooltip}" Background="Transparent">
                                                        <Grid Height="115">
                                                            <Border VerticalAlignment="Bottom" Height="{Binding BarHeight}"
                                                                    Background="{StaticResource AccentBrush}" CornerRadius="2,2,0,0"/>
                                                        </Grid>
                                                        <TextBlock Text="{Binding Count}" HorizontalAlignment="Center" FontSize="10"/>
                                                        <TextBlock Text="{Binding Label}" HorizontalAlignment="Center" FontSize="9"
                                                                   Style="{StaticResource Muted}"/>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </StackPanel>
                            </Border>

                            <UniformGrid Columns="2">
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="By incident type" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                    <ItemsControl ItemsSource="{Binding TypeBars}" ItemTemplate="{StaticResource BarRowTemplate}"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="By resolution outcome" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                    <ItemsControl ItemsSource="{Binding OutcomeBars}" ItemTemplate="{StaticResource BarRowTemplate}"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="By time of day" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                    <ItemsControl ItemsSource="{Binding TimeBars}" ItemTemplate="{StaticResource BarRowTemplate}"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="By day of week" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                    <ItemsControl ItemsSource="{Binding WeekdayBars}" ItemTemplate="{StaticResource BarRowTemplate}"/>
                                </StackPanel>
                            </Border>
                            </UniformGrid>
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="Top locations" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                    <ItemsControl ItemsSource="{Binding LocationBars}" ItemTemplate="{StaticResource BarRowTemplate}"/>
                                </StackPanel>
                            </Border>
                            <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" FontSize="11" Margin="0,0,12,0"
                                       Text="Locations use the responders' coverage regions when they appear in the address, otherwise a part of the address, otherwise a ~1 km map cell."/>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <!-- OPERATOR PERFORMANCE (admin) -->
                <Grid>
                    <Grid.Style>
                        <Style TargetType="Grid" BasedOn="{StaticResource PageStyle}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CurrentPage}" Value="Operators">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="Operator performance" Style="{StaticResource Heading}" Margin="0,0,0,10"/>
                    <StackPanel Grid.Row="1" Margin="0,0,12,10">
                        <StackPanel Orientation="Horizontal">
                        <RadioButton Style="{StaticResource ChipButton}" GroupName="rangeO"
                                     IsChecked="{Binding AnalyticsRange, Mode=TwoWay, Converter={StaticResource EqualsParam}, ConverterParameter=Today}">
                                         <TextBlock Text="Today"/>
                                 </RadioButton>
                        <RadioButton Style="{StaticResource ChipButton}" GroupName="rangeO"
                                     IsChecked="{Binding AnalyticsRange, Mode=TwoWay, Converter={StaticResource EqualsParam}, ConverterParameter=7}">
                                         <TextBlock Text="7 days"/>
                                 </RadioButton>
                        <RadioButton Style="{StaticResource ChipButton}" GroupName="rangeO"
                                     IsChecked="{Binding AnalyticsRange, Mode=TwoWay, Converter={StaticResource EqualsParam}, ConverterParameter=30}">
                                         <TextBlock Text="30 days"/>
                                 </RadioButton>
                        <RadioButton Style="{StaticResource ChipButton}" GroupName="rangeO"
                                     IsChecked="{Binding AnalyticsRange, Mode=TwoWay, Converter={StaticResource EqualsParam}, ConverterParameter=90}">
                                         <TextBlock Text="90 days"/>
                                 </RadioButton>
                        <RadioButton Style="{StaticResource ChipButton}" GroupName="rangeO"
                                     IsChecked="{Binding AnalyticsRange, Mode=TwoWay, Converter={StaticResource EqualsParam}, ConverterParameter=All}">
                                         <TextBlock Text="All time"/>
                                 </RadioButton>
                        </StackPanel>
                        <TextBlock Text="{Binding RangeSummaryText}" Style="{StaticResource Muted}" Margin="0,8,0,0" FontSize="12"/>
                    </StackPanel>

                    <Border Grid.Row="2" Style="{StaticResource Card}" Padding="0">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource Muted}" TextWrapping="Wrap" FontSize="11" Margin="18,8,18,12"
                                       Text="Times run from the moment the report arrived. 'In target' uses the SLA targets on the Rules &amp; SLA page. 'Auto-assign' is the automatic rule. Dispatches are only attributed when they were done on a desk running this version."/>
                            <DataGrid ItemsSource="{Binding OperatorStats}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Operator" Binding="{Binding Name}" Width="*"/>
                                    <DataGridTextColumn Header="Acknowledged" Binding="{Binding AckCount}" Width="105"/>
                                    <DataGridTextColumn Header="Avg ack" Binding="{Binding AvgAckText}" Width="75"/>
                                    <DataGridTextColumn Header="Slowest ack" Binding="{Binding SlowestAckText}" Width="95"/>
                                    <DataGridTextColumn Header="Ack in target" Binding="{Binding AckMetText}" Width="100"/>
                                    <DataGridTextColumn Header="Dispatched" Binding="{Binding DispatchCount}" Width="90"/>
                                    <DataGridTextColumn Header="Avg dispatch" Binding="{Binding AvgDispatchText}" Width="100"/>
                                    <DataGridTextColumn Header="Slowest" Binding="{Binding SlowestDispatchText}" Width="80"/>
                                    <DataGridTextColumn Header="Dispatch in target" Binding="{Binding DispatchMetText}" Width="125"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </Border>
                </Grid>

                <!-- SCHEDULED REPORTS (admin) -->
                <Grid>
                    <Grid.Style>
                        <Style TargetType="Grid" BasedOn="{StaticResource PageStyle}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CurrentPage}" Value="Schedule">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="Scheduled reports" Style="{StaticResource Heading}" Margin="0,0,0,14"/>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel MaxWidth="620" HorizontalAlignment="Left" Margin="0,0,12,12" IsEnabled="{Binding IsAdmin}">
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="Automatic summary e-mail" FontSize="15" FontWeight="SemiBold"/>
                                    <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4,0,6"
                                               Text="Sends the incident summary to supervisors. It is sent by this desk, so Emergency Desk must be running and signed in at the time. Turn it on at one desk only, or supervisors get duplicates."/>
                                    <CheckBox Content="Send reports automatically" IsChecked="{Binding EditSchedule.Enabled}"/>
                                    <TextBlock Text="How often" Style="{StaticResource Label}"/>
                                    <ComboBox ItemsSource="{Binding ReportFrequencies}" SelectedItem="{Binding EditSchedule.Frequency}" HorizontalAlignment="Left"/>
                                    <TextBlock Text="Day (weekly reports only)" Style="{StaticResource Label}"/>
                                    <ComboBox ItemsSource="{Binding Weekdays}" SelectedItem="{Binding EditSchedule.WeeklyDay}" HorizontalAlignment="Left"/>
                                    <TextBlock Text="Send at (24-hour time, e.g. 07:30)" Style="{StaticResource Label}"/>
                                    <TextBox Text="{Binding EditSendTime, UpdateSourceTrigger=PropertyChanged}" Width="100" HorizontalAlignment="Left"/>
                                    <TextBlock Text="Recipients (separate with commas)" Style="{StaticResource Label}"/>
                                    <TextBox Text="{Binding EditSchedule.Recipients}"/>
                                    <CheckBox Content="Attach the report as a PDF" IsChecked="{Binding EditSchedule.AttachPdf}" Margin="0,10,0,0"/>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="Mail server (SMTP)" FontSize="15" FontWeight="SemiBold"/>
                                    <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4,0,0"
                                               Text="Use port 587 with SSL. Gmail and Outlook need an app password, not your normal password."/>
                                    <TextBlock Text="Server" Style="{StaticResource Label}"/>
                                    <TextBox Text="{Binding EditSchedule.SmtpHost}"/>
                                    <TextBlock Text="Port" Style="{StaticResource Label}"/>
                                    <TextBox Text="{Binding EditSchedule.SmtpPort}" Width="100" HorizontalAlignment="Left"/>
                                    <CheckBox Content="Use SSL / TLS" IsChecked="{Binding EditSchedule.SmtpUseSsl}" Margin="0,10,0,0"/>
                                    <TextBlock Text="User name" Style="{StaticResource Label}"/>
                                    <TextBox Text="{Binding EditSchedule.SmtpUser}"/>
                                    <TextBlock Text="Password" Style="{StaticResource Label}"/>
                                    <PasswordBox x:Name="SmtpPasswordBox"/>
                                    <TextBlock Text="{Binding SmtpPasswordHint}" Style="{StaticResource Muted}" FontSize="11" Margin="0,4,0,0"/>
                                    <TextBlock Text="'From' address" Style="{StaticResource Label}"/>
                                    <TextBox Text="{Binding EditSchedule.FromAddress}"/>
                                </StackPanel>
                            </Border>

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <Button Content="Save" Command="{Binding SaveScheduleCommand}" Style="{StaticResource PrimaryButton}"/>
                                <Button Content="Send test e-mail" Command="{Binding SendTestEmailCommand}"/>
                                <Button Content="Send report now" Command="{Binding SendReportNowCommand}"/>
                            </StackPanel>
                            <TextBlock Text="{Binding ScheduleStatus}" TextWrapping="Wrap" Style="{StaticResource Muted}"/>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <!-- AUDIT LOG (admin) -->
                <Grid>
                    <Grid.Style>
                        <Style TargetType="Grid" BasedOn="{StaticResource PageStyle}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CurrentPage}" Value="Audit">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <DockPanel Margin="0,0,12,10">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Content="Refresh" Command="{Binding RefreshAuditCommand}"/>
                            <Button Content="Verify integrity" Command="{Binding VerifyAuditCommand}"/>
                            <Button Content="Export CSV" Command="{Binding ExportAuditCsvCommand}" Margin="0"/>
                        </StackPanel>
                        <TextBlock Text="Audit log" Style="{StaticResource Heading}"/>
                    </DockPanel>

                    <StackPanel Grid.Row="1" Margin="0,0,12,10">
                        <TextBox Text="{Binding AuditSearch, UpdateSourceTrigger=PropertyChanged}" ToolTip="Filter by operator, action, target or details"/>
                        <TextBlock Text="{Binding AuditInfo}" Style="{StaticResource Muted}" FontSize="11" Margin="0,6,0,0" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding AuditVerifyText}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,4,0,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="#3DD68C"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding AuditVerifyOk}" Value="False">
                                            <Setter Property="Foreground" Value="#FF6B6F"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>

                    <Border Grid.Row="2" Style="{StaticResource Card}" Padding="0">
                        <DataGrid ItemsSource="{Binding AuditView}" CanUserSortColumns="False">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="#" Binding="{Binding Seq}" Width="55"/>
                                <DataGridTextColumn Header="Time" Binding="{Binding TimeLocal}" Width="150"/>
                                <DataGridTextColumn Header="Operator" Binding="{Binding Operator}" Width="110"/>
                                <DataGridTextColumn Header="Role" Binding="{Binding Role}" Width="75"/>
                                <DataGridTextColumn Header="Action" Binding="{Binding Action}" Width="150"/>
                                <DataGridTextColumn Header="Target" Binding="{Binding Target}" Width="110"/>
                                <DataGridTextColumn Header="Details" Binding="{Binding Details}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </Grid>

                <!-- USERS (admin) -->
                <Grid>
                    <Grid.Style>
                        <Style TargetType="Grid" BasedOn="{StaticResource PageStyle}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CurrentPage}" Value="Users">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <DockPanel Margin="0,0,12,14">
                        <Button DockPanel.Dock="Right" Content="Activate / Deactivate selected"
                                Command="{Binding ToggleUserCommand}" Margin="0"/>
                        <TextBlock Text="App users" Style="{StaticResource Heading}"/>
                    </DockPanel>

                    <Border Grid.Row="1" Style="{StaticResource Card}" Padding="0">
                        <DataGrid ItemsSource="{Binding Users}" SelectedItem="{Binding SelectedUser}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Name" Binding="{Binding FullName}" Width="*"/>
                                <DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="220"/>
                                <DataGridTextColumn Header="Phone" Binding="{Binding Phone}" Width="130"/>
                                <DataGridTextColumn Header="Registered" Binding="{Binding RegisteredLocal}" Width="110"/>
                                <DataGridCheckBoxColumn Header="Active" Binding="{Binding IsActive, Mode=OneWay}" Width="70"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </Grid>
            </Grid>

            <!-- Status bar -->
            <Border Grid.Row="2" Padding="0,8,12,10">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Right" Style="{StaticResource Muted}" FontSize="12"
                               Text="{Binding LastUpdated, StringFormat='Updated {0:T}'}"/>
                    <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource Muted}" FontSize="12"/>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
