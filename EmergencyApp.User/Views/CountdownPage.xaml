<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:EmergencyApp.User.ViewModels"
             x:Class="EmergencyApp.User.Views.CountdownPage"
             x:DataType="vm:CountdownViewModel"
             BackgroundColor="#C62828"
             Shell.NavBarIsVisible="False" Shell.TabBarIsVisible="False">
    <Grid RowDefinitions="*,Auto,Auto" Padding="28">
        <VerticalStackLayout VerticalOptions="Center" Spacing="8">
            <Label Text="Sending SOS in" TextColor="White" FontSize="22" HorizontalTextAlignment="Center" />
            <Label Text="{Binding SecondsLeft}" TextColor="White" FontSize="140" FontAttributes="Bold" HorizontalTextAlignment="Center" />
            <Label Text="{Binding Summary}" TextColor="White" FontSize="18" HorizontalTextAlignment="Center" />
            <Label Text="Your live location is shared automatically." TextColor="#FFCDD2" HorizontalTextAlignment="Center" />
        </VerticalStackLayout>
        <Button Grid.Row="1" Text="CANCEL" BackgroundColor="White" TextColor="#C62828"
                HeightRequest="72" FontSize="24" Command="{Binding CancelCommand}" />
        <Button Grid.Row="2" Text="Send now" BackgroundColor="Transparent" TextColor="White"
                BorderColor="White" BorderWidth="2" Margin="0,12,0,0" Command="{Binding SendNowCommand}" />
    </Grid>
</ContentPage>
